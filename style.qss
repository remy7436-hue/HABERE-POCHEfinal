/* --- Fenêtre principale et conteneurs --- */
QMainWindow {
    background-color: #1e272e;
}

QWidget {
    color: #ecf0f1;
    font-family: "Segoe UI", Arial, sans-serif;
}

/* --- Onglets (QTabWidget) --- */
QTabWidget::pane {
    border: 1px solid #34495e;
    background-color: #2c3e50;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #34495e;
    color: #bdc3c7;
    font-size: 10pt;
    font-weight: bold;
    padding: 8px 12px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: #2980b9;
    color: #ffffff;
}

QTabBar::tab:hover {
    background-color: #3d566e;
}

/* --- Boutons --- */
QPushButton {
    background-color: #2980b9;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 10pt;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #3498db;
}

QPushButton:pressed {
    background-color: #1f618d;
}

/* --- Tuiles / Cartes météo (QFrame) --- */
QFrame {
    background-color: #34495e;
    border-radius: 8px;
    border: 1px solid #4e6d8c;
}

/* --- Tableaux (QTableWidget) --- */
QTableWidget {
    background-color: #2c3e50;
    alternate-background-color: #34495e;
    gridline-color: #4e6d8c;
    color: #ecf0f1;
    border: 1px solid #34495e;
    border-radius: 4px;
}

QHeaderView::section {
    background-color: #1f2c34;
    color: #ffffff;
    padding: 6px;
    border: none;
    font-weight: bold;
}

/* --- QLabel spécifiques --- */
QLabel {
    background: transparent;
}
